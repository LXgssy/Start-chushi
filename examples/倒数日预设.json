{
  "chushi": 1,
  "name": "倒数日",
  "author": "初始",
  "description": "左上角常驻倒数日卡片，点击可改事件与日期，数据保存在本机",
  "widgets": [
    {
      "id": "countdown",
      "name": "倒数日卡片",
      "corner": "top-left",
      "width": 200,
      "height": 96,
      "html": "<!doctype html><meta charset=\"utf-8\"><style>\nhtml,body{margin:0;height:100%}\nbody{\n  box-sizing:border-box;overflow:hidden;cursor:pointer;user-select:none;\n  font-family:system-ui,-apple-system,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;\n  -webkit-font-smoothing:antialiased;\n  background:rgba(255,255,255,.58);\n  border:1px solid rgba(0,0,0,.06);\n  border-radius:18px;\n  box-shadow:0 10px 30px rgba(0,0,0,.10);\n  padding:13px 16px 12px;\n  color:#27272a;\n}\nhtml[data-theme=\"dark\"] body{\n  background:rgba(39,39,42,.52);\n  border-color:rgba(255,255,255,.08);\n  box-shadow:0 10px 30px rgba(0,0,0,.38);\n  color:#e4e4e7;\n}\n#label{margin:0;font-size:11px;font-weight:400;letter-spacing:.18em;opacity:.62;\n  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n#num{margin:3px 0 0;font-size:38px;line-height:1.12;font-weight:200;letter-spacing:.02em;\n  color:var(--w-accent,#8b5cf6);font-variant-numeric:tabular-nums}\n#num small{font-size:14px;font-weight:300;letter-spacing:.1em;margin-left:5px;opacity:.85}\n#sub{margin:2px 0 0;font-size:10.5px;font-weight:300;letter-spacing:.06em;opacity:.5;\n  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n#edit{margin-top:9px;cursor:default}\n#edit[hidden]{display:none}\n#edit input{box-sizing:border-box;width:100%;margin:0 0 6px;padding:5px 8px;font-size:11px;\n  font-family:inherit;border-radius:8px;outline:none;\n  border:1px solid rgba(0,0,0,.12);background:rgba(255,255,255,.7);color:inherit}\nhtml[data-theme=\"dark\"] #edit input{border-color:rgba(255,255,255,.16);background:rgba(255,255,255,.06)}\n#edit .row{display:flex;gap:6px}\n#edit button{flex:1;all:unset;cursor:pointer;text-align:center;padding:5px 0;font-size:11px;\n  letter-spacing:.12em;border-radius:8px;border:1px solid rgba(0,0,0,.10)}\n#edit button:hover{background:rgba(0,0,0,.05)}\nhtml[data-theme=\"dark\"] #edit button{border-color:rgba(255,255,255,.14)}\nhtml[data-theme=\"dark\"] #edit button:hover{background:rgba(255,255,255,.08)}\n#edit button.primary{background:var(--w-accent,#8b5cf6);border-color:transparent;color:#fff}\n#edit button.primary:hover{opacity:.88}\n</style>\n<div id=\"app\">\n  <p id=\"label\">倒数日</p>\n  <p id=\"num\">--<small>天</small></p>\n  <p id=\"sub\"></p>\n  <div id=\"edit\" hidden>\n    <input id=\"e-name\" maxlength=\"12\" placeholder=\"事件名（如 生日 / 考研）\">\n    <input id=\"e-date\" type=\"date\">\n    <div class=\"row\"><button id=\"e-save\" class=\"primary\">保存</button><button id=\"e-cancel\">取消</button></div>\n  </div>\n</div>\n<script>\n(function(){\n  var labelEl=document.getElementById('label'),numEl=document.getElementById('num'),subEl=document.getElementById('sub');\n  var editEl=document.getElementById('edit'),nameEl=document.getElementById('e-name'),dateEl=document.getElementById('e-date');\n  function pad(n){return(n<10?'0':'')+n}\n  function today(){var d=new Date();return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())}\n  function nextYear(){return (new Date().getFullYear()+1)+'-01-01'}\n  var cfg={name:'新年',target:nextYear()};\n  var editing=false;\n  function daysTo(t){var p=(t||'').split('-');if(p.length!==3)return null;\n    var tgt=new Date(+p[0],+p[1]-1,+p[2]);if(isNaN(tgt))return null;\n    var n=new Date();var td=new Date(n.getFullYear(),n.getMonth(),n.getDate());\n    return Math.round((tgt-td)/86400000)}\n  function render(){\n    var d=daysTo(cfg.target);\n    labelEl.textContent=cfg.name||'倒数日';\n    if(d===null){numEl.innerHTML='--<small>天</small>';subEl.textContent='日期未设置'}\n    else if(d===0){numEl.innerHTML='今天<small></small>';subEl.textContent='就是今天 · '+cfg.target.replace(/-/g,' / ')}\n    else if(d===1){numEl.innerHTML='明天<small></small>';subEl.textContent='还差 1 天 · '+cfg.target.replace(/-/g,' / ')}\n    else if(d>0){numEl.innerHTML=String(d)+'<small>天</small>';subEl.textContent='距 '+cfg.target.replace(/-/g,' / ')}\n    else{numEl.innerHTML=String(-d)+'<small>天</small>';subEl.textContent='已过 · '+cfg.target.replace(/-/g,' / ')}\n  }\n  function setEdit(on){\n    editing=on;\n    editEl.hidden=!on;\n    if(on){nameEl.value=cfg.name;dateEl.value=cfg.target||today();nameEl.focus();\n      chushi.resize(0,196)}\n    else{chushi.resize(0,96)}\n  }\n  document.getElementById('app').addEventListener('click',function(e){\n    if(editing)return;\n    e.stopPropagation();setEdit(true);\n  });\n  document.getElementById('e-save').addEventListener('click',function(e){\n    e.stopPropagation();\n    var name=(nameEl.value||'').trim().slice(0,12)||'倒数日';\n    var target=dateEl.value;\n    if(!/^\\d{4}-\\d{2}-\\d{2}$/.test(target||'')){dateEl.focus();return}\n    cfg={name:name,target:target};\n    chushi.storage.set('cfg',cfg).then(function(){render();setEdit(false);\n      chushi.notify({title:'倒数日已更新',description:name+' · '+target})});\n  });\n  document.getElementById('e-cancel').addEventListener('click',function(e){\n    e.stopPropagation();render();setEdit(false)});\n  editEl.addEventListener('click',function(e){e.stopPropagation()});\n  chushi.storage.get('cfg').then(function(v){\n    if(v&&typeof v==='object'&&v.name&&typeof v.target==='string')cfg={name:String(v.name).slice(0,12),target:v.target};\n    render();\n  });\n})();\n</script>"
    }
  ]
}
